{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "alwaysStrict": true,

    "target": "ES2023",

    "module": "Node16",
    "moduleResolution": "Node16",

    "rootDir": ".",
    "outDir": "./lib",

    "skipLibCheck": true,
    "lib": ["es2023"],

    "importHelpers": false,
    "noEmitHelpers": true,
    "noEmitOnError": true,

    "inlineSourceMap": false,
    "sourceMap": true,

    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,

    "types": [],

    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": false,
    "useDefineForClassFields": false,

    "ignoreDeprecations": "6.0"
  },

  "ts-node": {
    "transpileOnly": true,
    "compiler": "typescript-cached-transpile"
  },

  "include": ["src/**/*"]
}